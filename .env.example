# Application Configuration
APP_NAME=MedOps
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medops_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medops_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# JWT Security
JWT_SECRET_KEY=super-secret-jwt-key-for-medops-production-change-me-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ORIGINS=["*"]
